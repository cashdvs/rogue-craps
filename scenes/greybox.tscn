[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/ui/greybox.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/data/die_data.gd" id="2_diedata"]
[ext_resource type="Resource" path="res://resources/dice/ember.tres" id="3_ember"]
[ext_resource type="Resource" path="res://resources/dice/lucky_knuckle.tres" id="4_knuckle"]
[ext_resource type="Resource" path="res://resources/bets/bet_catalog.tres" id="6_catalog"]

[node name="Greybox" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")
starting_dice = Array[ExtResource("2_diedata")]([ExtResource("3_ember"), ExtResource("4_knuckle")])
bet_catalog = ExtResource("6_catalog")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.07, 0.25, 0.14, 1)

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 32.0
offset_top = 20.0
offset_right = -32.0
offset_bottom = -20.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="TopBar" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 48
alignment = 1

[node name="TableLabel" type="Label" parent="Layout/TopBar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Greybox table"

[node name="CoinLabel" type="Label" parent="Layout/TopBar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.3, 1)
theme_override_font_sizes/font_size = 22
text = "Coin: 0"




[node name="DiceRow" type="HBoxContainer" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 48
alignment = 1

[node name="StateRow" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 64
alignment = 1

[node name="TotalLabel" type="Label" parent="Layout/StateRow"]
unique_name_in_owner = true
layout_mode = 2
