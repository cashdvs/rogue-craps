[sub_resource type="Shader" id="Shader_wipe"]
code = "// Left-to-right wipe from splash_motion.md (wordmark/main). Texture must not be atlased.
shader_type canvas_item;
uniform float reveal : hint_range(0.0, 1.0) = 0.0;
uniform float edge = 0.06;
void fragment() {
	vec4 c = texture(TEXTURE, UV) * COLOR;
	float m = clamp((reveal * (1.0 + edge) - UV.x) / edge, 0.0, 1.0);
	COLOR = vec4(c.rgb, c.a * m);
}
"

