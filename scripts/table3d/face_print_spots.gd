## Baked mark spots for the d4 / d8 faces, chosen around the printed face
## art. The SPOTS block is GENERATED by tools/gen_face_print_spots.gd; do not
## edit it by hand. Per shape, per face slot (1..n): the mark centre as
## weights of that face's 3 corners (PolyBody.face_tri tri order).
##   d4: the Twin diamond, in the clearest spot between the printed circles.
##   d8: the rare glyph badge, in the corner farthest from the numeral.
##       Vector3.ZERO = it doesn't fit; tint the numeral instead.
class_name FacePrintSpots
extends RefCounted

## Twin diamond height (tip to tip), as a share of the face height.
const TWIN_SIZE := 0.22
## Rare glyph badge diameter, as a share of the face height.
const BADGE_SIZE := 0.30
## Gap kept from the face edges (the bevels), as a share of the face height.
const MARGIN := 0.05
## Gap kept from any printed ink, as a share of the face height.
const PAD := 0.02

const SPOTS := {
	&"d4": [Vector3(0.4167, 0.2167, 0.3667), Vector3(0.4167, 0.2167, 0.3667), Vector3(0.4167, 0.3667, 0.2167), Vector3(0.2500, 0.4500, 0.3000)],
	&"d8": [Vector3(0.0000, 0.0000, 0.0000), Vector3(0.0000, 0.0000, 0.0000), Vector3(0.0000, 0.0000, 0.0000), Vector3(0.0000, 0.0000, 0.0000), Vector3(0.0000, 0.0000, 0.0000), Vector3(0.0000, 0.0000, 0.0000), Vector3(0.0000, 0.0000, 0.0000), Vector3(0.0000, 0.0000, 0.0000)],
}


## The baked spot for [param slot] on a [param shape] die (ZERO if none).
static func spot(shape: StringName, slot: int) -> Vector3:
	var row: Array = SPOTS.get(shape, [])
	return row[slot - 1] if slot >= 1 and slot <= row.size() else Vector3.ZERO
