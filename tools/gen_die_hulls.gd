## Regenerates scripts/table3d/die_hull_data.gd from the 3D Artist's mobile meshes.
## Run from a scratch project with the .glb files and batch3_faces.json in
## /tmp/b3/ (until PR #102 merges they are not in this repo):
##   godot --headless --path <scratch> --script gen_die_hulls.gd
extends SceneTree
# shape id -> [glb base, read mode]
const DICE := {
	&"d4": ["caltrop_d4", "vertex"], &"d8": ["lantern_d8", "face"], &"d10": ["tithe_d10", "face"],
	&"d12": ["midnight_d12", "face"], &"d20": ["verdict_d20", "face"], &"talus": ["knucklebone_talus", "face"],
	&"keg": ["powder_keg_d6", "face"],
}
func v3(p: Vector3) -> String:
	return "Vector3(%.5f, %.5f, %.5f)" % [p.x, p.y, p.z]
func _initialize() -> void:
	var faces: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("/tmp/b3/batch3_faces.json"))
	var out := PackedStringArray()
	out.append("## GENERATED by tools/gen_die_hulls.gd from the 3D Artist's mobile-LOD meshes")
	out.append("## (art/models/dice/*_mobile.glb, main + PR #120, and batch3_faces.json). Do not edit by")
	out.append("## hand; regenerate when the art changes. Per shape: the convex hull of the")
	out.append("## mobile mesh (Mesh.create_convex_shape, cleaned, not simplified), how the")
	out.append("## result is read (top face or top vertex) and, per face slot, its local")
	out.append("## direction. Units: metres, +Y up, origin = centre of mass.")
	out.append("class_name DieHullData")
	out.append("extends RefCounted")
	out.append("")
	out.append("static var SHAPES: Dictionary = {")
	for id in DICE:
		var base: String = DICE[id][0]
		var doc := GLTFDocument.new()
		var st := GLTFState.new()
		doc.append_from_file("/tmp/b3/%s_mobile.glb" % base, st)
		var root := doc.generate_scene(st)
		var mi: MeshInstance3D = root.find_children("*", "MeshInstance3D", true, false)[0]
		var pts := (mi.mesh.create_convex_shape(true, false) as ConvexPolygonShape3D).points
		var aabb := mi.mesh.get_aabb()
		var half := maxf(maxf(maxf(absf(aabb.position.x), absf(aabb.end.x)), maxf(absf(aabb.position.y), absf(aabb.end.y))), maxf(absf(aabb.position.z), absf(aabb.end.z)))
		root.free()
		var dirs := PackedStringArray()
		var vals := PackedStringArray()
		for e in faces[base]["dirs"]:
			vals.append(str(int(e[0])))
			dirs.append(v3(Vector3(e[1][0], e[1][1], e[1][2]).normalized()))
		var ps := PackedStringArray()
		for p in pts:
			ps.append(v3(p))
		out.append("\t&\"%s\": {" % id)
		var alias: Dictionary = {"powder_keg_d6": "powder_keg_d3", "ferryman_coin": "ferryman_d2"}
		var srcs := ["\"%s_mobile.glb\"" % base]
		if alias.has(base):
			srcs.append("\"%s_mobile.glb\"" % alias[base])
		out.append("\t\t\"sources\": [%s]," % ", ".join(srcs))
		out.append("\t\t\"read\": &\"%s\"," % DICE[id][1])
		out.append("\t\t\"mesh_half_extent\": %.5f," % half)
		out.append("\t\t\"values\": [%s]," % ", ".join(vals))
		out.append("\t\t\"dirs\": [%s]," % ", ".join(dirs))
		out.append("\t\t\"hull\": PackedVector3Array([%s])," % ", ".join(ps))
		out.append("\t},")
	out.append("}")
	var f := FileAccess.open("/tmp/die_hull_data.gd", FileAccess.WRITE)
	f.store_string("\n".join(out) + "\n")
	f.close()
	print("ok")
	quit()
